# Database
DATABASE_URL=postgres://penycounts:penycounts@localhost:5432/penycounts

# JWT
JWT_SECRET=change-me-to-a-random-secret-key
JWT_EXPIRY_HOURS=72

# SMTP Email (required for user registration)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=PenyCounts <noreply@example.com>

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Frontend URL (for CORS and email verification links)
# Docker: http://localhost (or your domain)
# Dev: http://localhost:3000
FRONTEND_URL=http://localhost

# PostgreSQL (used by docker-compose)
POSTGRES_USER=penycounts
POSTGRES_PASSWORD=penycounts
POSTGRES_DB=penycounts
