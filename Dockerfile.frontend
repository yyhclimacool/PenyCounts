# =============================================================================
# Stage 1 — build Vite/React app
# =============================================================================
FROM node:20-alpine AS build
WORKDIR /app

# The lockfile includes Linux/musl optional native dependencies, so use it to
# keep Vite and Rolldown versions reproducible across host and container builds.
# React canary conflicts with Radix UI peer ranges, hence --legacy-peer-deps.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm config set fetch-timeout 600000 \
    && npm ci --legacy-peer-deps

COPY frontend/ ./
RUN npm run build

# =============================================================================
# Stage 2 — nginx static + API reverse proxy
# =============================================================================
FROM nginx:alpine AS runtime

COPY --from=build /app/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
