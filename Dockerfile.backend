# =============================================================================
# Stage 1 — cache dependencies
# =============================================================================
# FROM docker.m.daocloud.io/library/rust:1-slim-bookworm AS deps
FROM rust:1-slim-bookworm AS deps

WORKDIR /app

RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/Cargo.toml backend/Cargo.lock ./

# Create a dummy main.rs so cargo can resolve and download all dependencies
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN cargo build --release --locked
# Remove the dummy build artifacts (but keep downloaded crates in registry cache)
RUN rm -rf src target/release/deps/penycounts*

# =============================================================================
# Stage 2 — build the real application
# =============================================================================
FROM deps AS builder

COPY backend/src ./src
COPY backend/migrations ./migrations

# Touch main.rs to ensure it's recompiled (dependencies are already built)
RUN touch src/main.rs && cargo build --release --locked

# =============================================================================
# Stage 3 — minimal runtime
# =============================================================================
# FROM docker.m.daocloud.io/library/debian:bookworm-slim AS runtime
FROM debian:bookworm-slim AS runtime

RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --system --no-create-home --shell /usr/sbin/nologin penycounts

WORKDIR /app

COPY --from=builder /app/target/release/penycounts-backend /usr/local/bin/penycounts-backend
COPY --from=builder /app/migrations /app/migrations

RUN mkdir -p /app/logs && chown penycounts:penycounts /app/logs

USER penycounts

ENV SERVER_HOST=0.0.0.0

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/penycounts-backend"]
